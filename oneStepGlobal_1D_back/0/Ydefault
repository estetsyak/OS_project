FoamFile
{
    format      ascii;
    class       volScalarField;
    object      Ydefault;
}

dimensions      [];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    outlet
    {
        type            advective;
        fieldInf        0;
        lInf            0.05;
        value           uniform 0;
    }

    empty
    {
        type            empty;
    }
}
