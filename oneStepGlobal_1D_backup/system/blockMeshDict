FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 1;

vertices
(
    // z = -0.001
    (0      -0.05 -0.001)   // 0  торец трубы, низ
    (0.35   -0.05 -0.001)   // 1  ступень, низ
    (0.35    0.05 -0.001)   // 2  ступень, верх
    (0       0.05 -0.001)   // 3  торец трубы, верх
    (0.7    -0.35 -0.001)   // 4  правый низ полупространства
    (0.7    -0.05 -0.001)   // 5  правый низ канала
    (0.7     0.05 -0.001)   // 6  правый верх канала
    (0.7     0.35 -0.001)   // 7  правый верх полупространства
    (0.35   -0.35 -0.001)   // 8  низ левой стенки полупространства
    (0.35    0.35 -0.001)   // 9  верх левой стенки полупространства
    // z = +0.001
    (0      -0.05  0.001)   // 10
    (0.35   -0.05  0.001)   // 11
    (0.35    0.05  0.001)   // 12
    (0       0.05  0.001)   // 13
    (0.7    -0.35  0.001)   // 14
    (0.7    -0.05  0.001)   // 15
    (0.7     0.05  0.001)   // 16
    (0.7     0.35  0.001)   // 17
    (0.35   -0.35  0.001)   // 18
    (0.35    0.35  0.001)   // 19
);

blocks
(
    hex (0 1 2 3 10 11 12 13)  (175 50 1)  simpleGrading (1 1 1)  // труба
    hex (8 4 5 1 18 14 15 11)  (175 150 1) simpleGrading (1 1 1)  // полупространство, низ
    hex (1 5 6 2 11 15 16 12)  (175 50 1)  simpleGrading (1 1 1)  // продолжение трубы
    hex (2 6 7 9 12 16 17 19)  (175 150 1) simpleGrading (1 1 1)  // полупространство, верх
);

edges ();

boundary
(
    // Закрытый торец трубы — BC как у старого `left`
    inlet
    {
        type wall;
        faces ((0 3 13 10));
    }

    // Стенки трубы + вертикальные уступы расширения
    walls
    {
        type wall;
        faces
        (
            (0 1 11 10)   // низ трубы
            (3 2 12 13)   // верх трубы
            (1 8 18 11)   // нижний уступ
            (2 9 19 12)   // верхний уступ
        );
    }

    // Свободные выходы полупространства — BC как у старого `right`
    outlet
    {
        type patch;                // BC задаётся в 0/outlet
        faces
        (
            (4 5 15 14)   // правая грань, низ   (x=0.7, y∈[-0.35,-0.05])
            (5 6 16 15)   // правая грань, центр (x=0.7, y∈[-0.05, 0.05])
            (6 7 17 16)   // правая грань, верх  (x=0.7, y∈[ 0.05, 0.35])
            (8 4 14 18)   // низ  (y=-0.35)
            (9 7 17 19)   // верх (y= 0.35)
        );
    }

    // 2D
    empty
    {
        type empty;
        faces
        (
            (0 1 2 3)  (10 11 12 13)
            (8 4 5 1)  (18 14 15 11)
            (1 5 6 2)  (11 15 16 12)
            (2 6 7 9)  (12 16 17 19)
        );
    }
);

mergePatchPairs ();

