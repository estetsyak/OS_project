FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    p       1e5;
    T       300;
}

high 1e5;
low -1e5;

zones
{
    hotSpot
    {
        type        box;
        zoneType    cell;

        // x: [0, 0.035]     — первые 10% длины трубы от торца
        // y: [-0.05, 0.05]  — вся высота трубы
        // z: [-1e5, 1e5]    — «всё по z» (фиктивная ось)
        box (0 -0.05 -1e5) (0.035 0.05 1e5);

        values
        {
            p 13e5;
            T 1500;
        }
    }
}
